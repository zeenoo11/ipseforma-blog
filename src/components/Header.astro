---
/**
 * Header.astro — ipseforma blog header
 * Matches the fixed blur nav on ipseforma.com (main site).
 * Replaces the original AstroPaper Header.
 */
import IconRss from "@/assets/icons/IconRss.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import { SITE } from "@/config";

const { pathname } = Astro.url;
const isActive = (base: string) =>
  pathname === base || pathname.startsWith(base + "/") || (base !== "/" && pathname.startsWith(base));
---

<a
  id="skip-to-content"
  href="#main-content"
  class="ipf-skip"
>
  Skip to content
</a>

<nav class="ipf-nav" aria-label="Primary">
  <a href="/" class="ipf-brand">
    <span style="font-style: italic">i</span>pseforma<span class="dim">.</span>
  </a>

  <div class="ipf-navlinks">
    <a
      class="ipf-navlink"
      href="https://ipseforma.com"
      target="_blank"
      rel="noreferrer"
    >
      Philosophy
    </a>
    <a
      class:list={["ipf-navlink", { active: isActive("/posts") || pathname === "/" }]}
      href="/posts/"
    >
      Writing
    </a>
    <a
      class="ipf-navlink"
      href="https://ipseforma.com/#contact"
      target="_blank"
      rel="noreferrer"
    >
      Contact
    </a>
  </div>

  <div style="display:flex; align-items:center; gap:8px;">
    <a
      href="/rss.xml"
      class="ipf-iconbtn"
      title="RSS Feed"
      aria-label="RSS feed"
    >
      <IconRss width={14} height={14} />
    </a>
    {
      SITE.lightAndDarkMode && (
        <button
          id="theme-btn"
          class="ipf-iconbtn"
          title="Toggle light & dark"
          aria-label="toggle theme"
          aria-live="polite"
        >
          <IconMoon
            width={14}
            height={14}
            style="display:block;"
            class="ipf-icon-light"
          />
          <IconSunHigh
            width={14}
            height={14}
            style="display:none;"
            class="ipf-icon-dark"
          />
        </button>
      )
    }
  </div>
</nav>

<style is:global>
  .ipf-skip {
    position: absolute; left: 16px; top: -60px; z-index: 50;
    background: var(--paper); color: var(--ink);
    padding: 8px 12px; border: 1px solid var(--rule);
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em;
    text-transform: uppercase; text-decoration: none;
    transition: top 0.2s;
  }
  .ipf-skip:focus { top: 12px; }

  html[data-theme="dark"] .ipf-icon-light { display: none !important; }
  html[data-theme="dark"] .ipf-icon-dark { display: block !important; }
</style>
