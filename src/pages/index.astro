---
/**
 * index.astro — ipseforma blog index (Variation B · "Reading Room")
 * Centered column, quiet hero, year-grouped stanza rows.
 */
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sorted = getSortedPosts(posts);

// Group by year (newest first)
type Row = { id: string; filePath?: string; data: any; year: string; no: string };
const rows: Row[] = sorted.map((p, i) => ({
  id: p.id,
  filePath: p.filePath,
  data: p.data,
  year: new Date(p.data.pubDatetime).getUTCFullYear().toString(),
  no: String(sorted.length - i).padStart(3, "0"),
}));

const groups: { year: string; posts: Row[] }[] = [];
for (const r of rows) {
  let g = groups.find(x => x.year === r.year);
  if (!g) { g = { year: r.year, posts: [] }; groups.push(g); }
  g.posts.push(r);
}

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "2-digit" });

// Read-time helper — rough words/min estimate from the body text
const WPM = 220;
const readMin = (p: any) => {
  const txt = (p.body || "").replace(/[^\w\s]/g, " ");
  const n = txt.trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(n / WPM));
};
---

<Layout>
  <Header />

  <main id="main-content" class="ipf-index-wrap">
    <!-- Hero -->
    <header class="ipf-index-hero">
      <div class="ipf-meta" style="margin-bottom: 28px;">§ — Writing</div>
      <h1 class="ipf-display">
        The reading<br /><em>room.</em>
      </h1>
      <p>
        A small collection of essays, notebook entries, and fragments.
        Updated when a thing is ready, not before.
      </p>
      <div class="ipf-index-cta">
        <a href="/rss.xml" class="ipf-pill">
          <span class="dot"></span> Subscribe · RSS
        </a>
        <a href="#all" class="ipf-pill" style="border-color: var(--ink);">
          {sorted.length} pieces ↓
        </a>
      </div>
    </header>

    <!-- Year groups -->
    <div id="all">
      {groups.map(group => (
        <section class="ipf-year-group">
          <div class="ipf-year-label">
            <div class="year">{group.year}</div>
            <div class="ipf-meta">
              {group.posts.length} {group.posts.length === 1 ? "entry" : "entries"}
            </div>
          </div>

          <div>
            {group.posts.map(p => {
              const href = getPath(p.id, p.filePath);
              const tag = p.data.tags?.[0] ?? "Notebook";
              return (
                <a href={href} class="ipf-row-b">
                  <div class="rowhead">
                    <span class="no">{p.no}</span>
                    <span class="ipf-meta">
                      {fmt(new Date(p.data.pubDatetime))} · {tag} · {readMin(p)} min
                    </span>
                  </div>
                  <h3
                    transition:name={slugifyStr(p.data.title.replaceAll(".", "-"))}
                  >
                    {p.data.title}
                  </h3>
                  {p.data.description && <p>{p.data.description}</p>}
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>

    <div class="ipf-index-foot">
      <div class="colophon">Written mostly at dawn, revised mostly at dusk.</div>
      <div class="ipf-meta">© MMXXVI ipseforma</div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  // Remember index location for BackButton-style returns
  document.addEventListener("astro:page-load", () => {
    sessionStorage.setItem("backUrl", "/");
  });
</script>
