---
/**
 * PostDetails.astro — ipseforma blog post (Variation A · "Editorial Ledger")
 * Layout: [left sidebar · date/tag/min/TOC] · [body 640px] · [right rail · folio %]
 * Scroll progress bar fixed at top of viewport.
 */
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;
const { title, author, description, ogImage: initOgImage, pubDatetime, modDatetime, tags, canonicalURL } = post.data;
const { Content, headings } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "2-digit" });

// Read time
const WPM = 220;
const wc = (post.body || "").replace(/[^\w\s]/g, " ").trim().split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.round(wc / WPM));

// Prev/Next (posts array is pre-sorted newest-first)
const allPosts = posts.map(({ data: { title }, id, filePath }) => ({ id, title, filePath }));
const cur = allPosts.findIndex(p => p.id === post.id);
const prevPost = cur > 0 ? allPosts[cur - 1] : null;
const nextPost = cur < allPosts.length - 1 ? allPosts[cur + 1] : null;

// Folio number (matches index)
const idx = posts.findIndex(p => p.id === post.id);
const folioNo = idx >= 0 ? String(posts.length - idx).padStart(3, "0") : "—";

// TOC from rendered headings (h2/h3)
const toc = (headings ?? []).filter(h => h.depth === 2 || h.depth === 3);

// OG image — preserve dynamic OG image feature
let ogImageUrl: string | undefined;
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage: ogImageUrl,
  scrollSmooth: true,
};
---

<Layout {...layoutProps}>
  <Header />

  <main id="main-content" data-pagefind-body>
    <article class="ipf-post-wrap">
      <!-- Left sidebar -->
      <aside class="ipf-side">
        <div class="ipf-side-inner">
          <a
            href="/"
            class="ipf-meta backlink"
            data-back-link
          >
            <span>←</span> Index
          </a>

          <div>
            <div class="ipf-meta field-label">Date</div>
            <div class="field-value">{fmt(new Date(pubDatetime))}</div>
          </div>

          {tags?.length > 0 && (
            <div>
              <div class="ipf-meta field-label">Tag</div>
              <div style="display:flex; flex-wrap:wrap; gap:6px;">
                {tags.map(t => (
                  <a href={`/tags/${slugifyStr(t)}`} class="ipf-tag">{t}</a>
                ))}
              </div>
            </div>
          )}

          <div>
            <div class="ipf-meta field-label">Reading</div>
            <div class="field-value">{readMin} min</div>
          </div>

          {toc.length > 0 && (
            <>
              <hr class="ipf-hairline" />
              <div>
                <div class="ipf-meta field-label" style="margin-bottom:12px;">Contents</div>
                <ol class="ipf-toc-list" id="ipf-toc">
                  {toc.map(h => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        data-toc-link
                        data-target={h.slug}
                        style={h.depth === 3 ? "padding-left: 22px; font-size: 13px;" : ""}
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            </>
          )}
        </div>
      </aside>

      <!-- Body -->
      <div class="ipf-post-body">
        <div class="ipf-meta eyebrow">
          № {folioNo} · {tags?.[0] ?? "Writing"}
        </div>
        <h1
          transition:name={slugifyStr(title.replaceAll(".", "-"))}
        >
          {title}
        </h1>
        {description && <p class="lede">{description}</p>}
        <hr class="ipf-hairline" style="margin-bottom: 40px;" />

        <div class="app-prose ipf-prose" id="article">
          <Content />
        </div>

        <!-- Prev / Next -->
        <div class="ipf-prevnext">
          {prevPost ? (
            <a href={getPath(prevPost.id, prevPost.filePath)} class="prev">
              <div class="ipf-meta">← Previous</div>
              <div class="title">{prevPost.title}</div>
            </a>
          ) : <span />}
          {nextPost ? (
            <a href={getPath(nextPost.id, nextPost.filePath)} class="next">
              <div class="ipf-meta">Next →</div>
              <div class="title">{nextPost.title}</div>
            </a>
          ) : <span />}
        </div>
      </div>

      <!-- Right rail · folio % -->
      <aside class="ipf-side">
        <div class="ipf-side-inner ipf-folio" style="position:sticky; top:120px;">
          <div class="ipf-meta">Folio</div>
          <div class="pct"><span id="ipf-folio-n">0</span><sup>%</sup></div>
          <div class="ipf-meta">read</div>
        </div>
      </aside>
    </article>
  </main>

  <Footer />
</Layout>

<script is:inline data-astro-rerun>
  // Top progress bar
  (function () {
    if (document.getElementById("myBar")) return;
    const wrap = document.createElement("div");
    wrap.className = "ipf-progress-container";
    const bar = document.createElement("div");
    bar.className = "ipf-progress-bar";
    bar.id = "myBar";
    wrap.appendChild(bar);
    document.body.appendChild(wrap);
  })();

  function updateProgress() {
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight;
    const p = max > 0 ? (h.scrollTop / max) * 100 : 0;
    const bar = document.getElementById("myBar");
    if (bar) bar.style.width = p + "%";
    const n = document.getElementById("ipf-folio-n");
    if (n) n.textContent = String(Math.round(p));

    // Active TOC highlight
    const links = document.querySelectorAll("[data-toc-link]");
    let activeId = null;
    const hs = Array.from(document.querySelectorAll("#article h2, #article h3"));
    for (let i = hs.length - 1; i >= 0; i--) {
      const r = hs[i].getBoundingClientRect();
      if (r.top < 160) { activeId = hs[i].id; break; }
    }
    links.forEach(a => {
      a.classList.toggle("active", a.getAttribute("data-target") === activeId);
    });
  }

  document.addEventListener("scroll", updateProgress, { passive: true });
  updateProgress();

  // Back link — uses stored index URL or falls back to "/"
  (function () {
    const l = document.querySelector("[data-back-link]");
    if (l) {
      const back = sessionStorage.getItem("backUrl") || "/";
      l.setAttribute("href", back);
    }
  })();

  // Smooth-scroll TOC jumps (account for fixed nav)
  document.querySelectorAll("[data-toc-link]").forEach(a => {
    a.addEventListener("click", (e) => {
      const id = a.getAttribute("data-target");
      const t = id && document.getElementById(id);
      if (!t) return;
      e.preventDefault();
      const y = t.getBoundingClientRect().top + window.scrollY - 100;
      window.scrollTo({ top: y, behavior: "smooth" });
      history.replaceState(null, "", "#" + id);
    });
  });

  // Heading anchor links
  function addHeadingLinks() {
    const headings = Array.from(document.querySelectorAll("#article h2, #article h3, #article h4"));
    for (const heading of headings) {
      if (!heading.id) continue;
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className = "heading-link ms-2 no-underline opacity-0 group-hover:opacity-60 focus:opacity-60";
      link.href = "#" + heading.id;
      link.setAttribute("aria-hidden", "true");
      const span = document.createElement("span");
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  // Copy buttons on code blocks
  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));
    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";
      const copyButton = document.createElement("button");
      copyButton.className = "copy-code absolute end-3 -top-3 rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium";
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);
      copyButton.addEventListener("click", async () => {
        const code = codeBlock.querySelector("code");
        const text = code?.innerText;
        await navigator.clipboard.writeText(text ?? "");
        copyButton.innerText = "Copied";
        setTimeout(() => { copyButton.innerText = copyButtonLabel; }, 700);
      });
    }
  }
  attachCopyButtons();

  document.addEventListener("astro:after-swap", () => {
    window.scrollTo({ left: 0, top: 0, behavior: "instant" });
    updateProgress();
  });
</script>
